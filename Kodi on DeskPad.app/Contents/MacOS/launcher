#!/bin/bash
# Thin wrapper so the launcher can be double-clicked from Finder/Dock.
# Logs each run so a failed double-click is diagnosable after the fact.
SCRIPT="/Users/deepak/work/apps/deskpad/launch-kodi-on-deskpad.sh"
LOG="$HOME/Library/Logs/kodi-on-deskpad.log"

if [ ! -x "$SCRIPT" ]; then
    osascript -e "display alert \"Kodi on DeskPad\" message \"Launcher script missing or not executable:
$SCRIPT\" as critical" >/dev/null 2>&1
    exit 1
fi

{
    echo "===== $(date '+%Y-%m-%d %H:%M:%S') ====="
    "$SCRIPT"
    echo "exit=$?"
} >>"$LOG" 2>&1
